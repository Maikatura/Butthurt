<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Butthurt.Desktop.Views.MainWindow"
        Icon="avares://Butthurt.Desktop/Assets/appicon.ico"
        Title="Butthurt - Game Plugin Manager"
        Background="#000000"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="800"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        
        <!-- Rounded borders -->
        <Style Selector="Border.rounded">
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Main content area -->
        <Style Selector="Border.main-content">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#0d0d0d"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200,*" Background="#000000">

        <!-- === SIDEBAR === -->
        <Border >
            <StackPanel x:Name="SidebarSections" Spacing="10"/>
        </Border>


        <!-- === MAIN CONTENT AREA === -->
        <Border Grid.Column="1" Classes="main-content" Margin="10">
            <Grid>
                <!-- Main content -->
                <ContentControl x:Name="MainContent"/>

                <!-- Notification overlay -->
                <StackPanel x:Name="NotificationPanel"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="10"
                            Spacing="5"
                            ZIndex="100"/>
            </Grid>
        </Border>

       
    </Grid>
    
    
    
</Window>
