<Project Sdk="Microsoft.NET.Sdk">
    <!-- VRChat plugin: changes avatars and grows/shrinks you over OSC, driven by Twitch rules. -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Referenced directly (not only through Contracts) so the XAML compiler runs for this project -->
        <PackageReference Include="Avalonia" Version="11.3.6"/>
        <PackageReference Include="IconPacks.Avalonia" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Butthurt.Contracts\Butthurt.Contracts.csproj" />
        <!-- VRChat rules react to Twitch events and reuse its conditions and editor -->
        <ProjectReference Include="..\Butthurt.Twitch\Butthurt.Twitch.csproj" />
    </ItemGroup>
</Project>
