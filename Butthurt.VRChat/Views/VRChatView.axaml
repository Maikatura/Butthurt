<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Butthurt.VRChat.Views.VRChatView">

    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Classes="page">
        <StackPanel Spacing="20" Margin="32,28" MaxWidth="1040">

            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="VRChat"/>
                <TextBlock Classes="muted" Text="Let your Twitch chat change your avatar and your size. Every action is a rule you control."/>
            </StackPanel>

            <!-- Twitch link: VRChat rules only get events through the Twitch plugin -->
            <Border x:Name="TwitchBanner" Classes="row" BorderBrush="#5B4A1F" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <iconPacks:PackIconLucide Kind="Twitch" Width="18" Height="18" Foreground="#FCD34D"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TwitchBannerText" Grid.Column="1" Classes="muted" Foreground="#FCD34D" VerticalAlignment="Center"/>
                    <Button x:Name="TwitchBannerButton" Grid.Column="2" Classes="bt small" Margin="12,0,0,0" Click="TwitchBanner_Click"/>
                </Grid>
            </Border>

            <!-- Connection and live size -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="iconbox" Margin="0,0,14,0">
                            <iconPacks:PackIconLucide Kind="Glasses" Width="20" Height="20" Foreground="#D8B4FE"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="h2" Text="VRChat"/>
                                <Border Classes="pill" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatePillText" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="StateText" Classes="muted"/>
                        </StackPanel>
                        <Button x:Name="StartStopButton" Grid.Column="2" Classes="bt" VerticalAlignment="Center" Click="StartStop_Click"/>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,-12,0">
                        <Border Classes="row" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="SIZE"/>
                                <TextBlock x:Name="SizeText" Classes="stat"/>
                                <TextBlock x:Name="HeightText" Classes="muted" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="row" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="AVATAR"/>
                                <TextBlock x:Name="AvatarText" Classes="h3" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AvatarHint" Classes="muted" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Active effects: one fixed-height row, so spamming Test never pushes the page around -->
                    <Border Classes="row" Padding="10,0" Height="46">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="caption" Text="ACTIVE" VerticalAlignment="Center" Margin="2,0,12,0"/>
                            <TextBlock x:Name="NoEffectsText" Grid.Column="1" Classes="muted" FontSize="12"
                                       VerticalAlignment="Center" Text="Nothing running"/>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="EffectList" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Button x:Name="ResetButton" Classes="bt small" HorizontalAlignment="Left" Click="Reset_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Undo everything (size, parameters and avatar)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Rules -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="h2" Text="Rules"/>
                            <TextBlock Classes="muted"
                                       Text="When something happens on Twitch, do something in VRChat. Grow rules can stack: ×1.1 twice is ×1.21."/>
                        </StackPanel>
                        <Button x:Name="AddRuleButton" Grid.Column="1" Classes="bt primary" VerticalAlignment="Center" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Add rule" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="NoRulesText" Classes="muted" IsVisible="False" Text="No rules yet."/>
                    <StackPanel x:Name="RuleList" Spacing="8"/>
                </StackPanel>
            </Border>

            <!-- Stream overlay and announcements -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Classes="h2" Text="Stream overlay and announcements"/>
                        <TextBlock Classes="muted"
                                   Text="Show the queue and an announcement for every rule on stream. Each rule's message is yours to write, in the rule's editor."/>
                    </StackPanel>

                    <Border Classes="row">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="h3" Text="OBS overlay"/>
                                        <Border Classes="pill" VerticalAlignment="Center">
                                            <TextBlock x:Name="OverlayPillText" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="muted" FontSize="12"
                                               Text="In OBS add a Browser source with this address, 1920 × 1080. It has a transparent background."/>
                                </StackPanel>
                                <ToggleSwitch x:Name="OverlayToggle" Grid.Column="1"/>
                            </Grid>

                            <StackPanel x:Name="OverlayOptions" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox x:Name="OverlayUrlBox" Classes="field" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Classes="bt small" Margin="8,0,0,0" VerticalAlignment="Center" Click="CopyOverlayUrl_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <iconPacks:PackIconLucide Kind="Copy" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="bt small" Margin="8,0,0,0" VerticalAlignment="Center" Click="OpenOverlay_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <iconPacks:PackIconLucide Kind="ExternalLink" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Preview" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <WrapPanel ItemSpacing="24" LineSpacing="8">
                                    <CheckBox x:Name="OverlayQueueCheck" Content="Show the queue"/>
                                    <CheckBox x:Name="OverlayAlertsCheck" Content="Show announcements"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="muted" FontSize="12" Text="Each announcement for (seconds)" VerticalAlignment="Center"/>
                                        <NumericUpDown x:Name="AlertSecondsBox" Minimum="1" Maximum="60" Increment="1" FormatString="0" MinWidth="120"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="muted" FontSize="12" Text="Port" VerticalAlignment="Center"/>
                                        <NumericUpDown x:Name="OverlayPortBox" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" MinWidth="130"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Where things go on screen, changes show in OBS right away -->
                                <Grid ColumnDefinitions="Auto,32,Auto,32,*">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="muted" FontSize="12" Text="Announcements"/>
                                        <ContentControl x:Name="AlertPositionHost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Classes="muted" FontSize="12" Text="Queue"/>
                                        <ContentControl x:Name="QueuePositionHost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="6" VerticalAlignment="Top">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="muted" FontSize="12" Text="Size"/>
                                            <TextBlock x:Name="OverlayScaleText" Grid.Column="1" Classes="muted" FontSize="12"/>
                                        </Grid>
                                        <Slider x:Name="OverlayScaleSlider" Minimum="0.5" Maximum="2.5"/>
                                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                   Text="Changes show in OBS right away. Press the test button below to see where announcements land."/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="Two Browser sources with different spots? Add options to the address, they win over the settings above: ?alerts=0 or ?queue=0 to show one part, ?alerts_at=bottom-left or ?queue_at=top-right to place it (any of top/middle/bottom with left/center/right), ?scale=1.5 for size. Combine them with &amp;."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Also post announcements in Twitch chat"/>
                                <TextBlock x:Name="ChatAnnounceText" Classes="muted" FontSize="12"
                                           Text="Posted as you, in your own chat. Tests are never posted."/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ChatAnnounceToggle" Grid.Column="1"/>
                        </Grid>
                    </Border>

                    <Button Classes="bt small" HorizontalAlignment="Left" Click="TestAnnouncement_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <iconPacks:PackIconLucide Kind="Sparkles" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Show a test announcement on the overlay" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Size settings -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Size and avatar" Margin="0,0,0,6"/>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Normal eye height (meters)"/>
                                <TextBlock Classes="muted" FontSize="12" Text="Growing multiplies this. With learning on, using VRChat's own scaling menu updates it."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <NumericUpDown x:Name="BaseHeightBox" Minimum="0.1" Maximum="100" Increment="0.05" FormatString="0.00" MinWidth="130"/>
                                <CheckBox x:Name="LearnHeightCheck" Content="Learn"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="h3" Text="Smooth size changes"/>
                                    <TextBlock Classes="muted" FontSize="12" Text="Growing and shrinking slide to the new size over this long, slow at the start and end. 0 jumps instantly."/>
                                </StackPanel>
                                <TextBlock x:Name="SmoothText" Grid.Column="1" Classes="stat" FontSize="18" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="SmoothSlider" Minimum="0" Maximum="5"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Size limits"/>
                                <TextBlock Classes="muted" FontSize="12" Text="However much stacks up, you never go smaller or bigger than this."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="muted" Text="×" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="MinMultiplierBox" Minimum="0.1" Maximum="1" Increment="0.05" FormatString="0.00" MinWidth="120"/>
                                <TextBlock Classes="muted" Text="to ×" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="MaxMultiplierBox" Minimum="1" Maximum="50" Increment="0.5" FormatString="0.0" MinWidth="120"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Your own avatar"/>
                                <TextBlock Classes="muted" FontSize="12"
                                           Text="Switched back to after temporary avatar changes when Butthurt doesn't know what you had on."/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="DefaultAvatarBox" Classes="field" Watermark="avtr_…"/>                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Start talking to VRChat when Butthurt starts"/>
                                <TextBlock x:Name="OscText" Classes="muted" FontSize="12"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
