<Project Sdk="Microsoft.NET.Sdk">
    <!-- World of Warcraft plugin: reads the addon's corner pixel and installs the addon. -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Referenced directly (not only through Contracts) so the XAML compiler runs for this project -->
        <PackageReference Include="Avalonia" Version="11.3.6"/>
        <PackageReference Include="IconPacks.Avalonia" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Butthurt.Contracts\Butthurt.Contracts.csproj" />
    </ItemGroup>

    <!-- Ship the WoW addons next to the exe so the app can install them without downloading anything -->
    <ItemGroup>
        <Content Include="..\Addon\**\*" LinkBase="Addon" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
