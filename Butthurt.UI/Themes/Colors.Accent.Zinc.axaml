<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="Accent0Color">#FEFCFE</Color>
            <Color x:Key="Accent1Color">#FBF7FE</Color>
            <Color x:Key="Accent2Color">#F7EDFE</Color>
            <Color x:Key="Accent3Color">#F2E2FC</Color>
            <Color x:Key="Accent4Color">#EAD5F9</Color>
            <Color x:Key="Accent5Color">#E0C4F4</Color>
            <Color x:Key="Accent6Color">#D1AFEC</Color>
            <Color x:Key="Accent7Color">#BE93E4</Color>
            <Color x:Key="Accent8Color">#8E4EC6</Color>
            <Color x:Key="Accent9Color">#8347B9</Color>
            <Color x:Key="Accent11Color">#8145B5</Color>
            <Color x:Key="Accent12Color">#402060</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Accent0Color">#09090B</Color>
            <Color x:Key="Accent1Color">#18181B</Color>
            <Color x:Key="Accent2Color">#27272A</Color>
            <Color x:Key="Accent3Color">#3F3F46</Color>
            <Color x:Key="Accent4Color">#52525B</Color>
            <Color x:Key="Accent5Color">#71717A</Color>
            <Color x:Key="Accent6Color">#A1A1AA</Color>
            <Color x:Key="Accent7Color">#D4D4D8</Color>
            <Color x:Key="Accent8Color">#E4E4E7</Color>
            <Color x:Key="Accent9Color">#FAFAFA</Color>
            <Color x:Key="Accent11Color">#FAFAFA</Color>
            <Color x:Key="Accent12Color">#FFFFFF</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
