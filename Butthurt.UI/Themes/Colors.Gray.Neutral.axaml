<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="Gray1Color">#FCFCFC</Color>
            <Color x:Key="Gray2Color">#F9F9F9</Color>
            <Color x:Key="Gray3Color">#F0F0F0</Color>
            <Color x:Key="Gray4Color">#E8E8E8</Color>
            <Color x:Key="Gray5Color">#E0E0E0</Color>
            <Color x:Key="Gray6Color">#D9D9D9</Color>
            <Color x:Key="Gray7Color">#CECECE</Color>
            <Color x:Key="Gray8Color">#BBBBBB</Color>
            <Color x:Key="Gray9Color">#8D8D8D</Color>
            <Color x:Key="Gray10Color">#838383</Color>
            <Color x:Key="Gray11Color">#646464</Color>
            <Color x:Key="Gray12Color">#202020</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Gray1Color">#09090B</Color>
            <Color x:Key="Gray2Color">#111113</Color>
            <Color x:Key="Gray3Color">#18181B</Color>
            <Color x:Key="Gray4Color">#1F1F23</Color>
            <Color x:Key="Gray5Color">#27272A</Color>
            <Color x:Key="Gray6Color">#2F2F34</Color>
            <Color x:Key="Gray7Color">#3F3F46</Color>
            <Color x:Key="Gray8Color">#52525B</Color>
            <Color x:Key="Gray9Color">#71717A</Color>
            <Color x:Key="Gray10Color">#7C7C85</Color>
            <Color x:Key="Gray11Color">#A1A1AA</Color>
            <Color x:Key="Gray12Color">#FAFAFA</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
