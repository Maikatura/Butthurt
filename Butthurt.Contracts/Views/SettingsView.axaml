<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Butthurt.Contracts.Views.SettingsView">

    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Classes="page">
        <StackPanel Spacing="20" Margin="32,28" MaxWidth="1040">

            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Settings"/>
                <TextBlock Classes="muted" Text="Everything is saved automatically. Game and streaming settings live on their own pages."/>
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Toys" Margin="0,0,0,6"/>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Toy features"/>
                                <TextBlock Classes="muted" FontSize="12"
                                           Text="Intiface, the Toys page, vibration rules and toy-only plugins like World of Warcraft. Turn it off to use Butthurt just for streaming and VRChat. Your toy settings are kept for when you turn it back on."/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToysToggle" Grid.Column="1"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="StartupCard" Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Startup" Margin="0,0,0,6"/>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Connect to Intiface when Butthurt starts"/>
                                <TextBlock Classes="muted" FontSize="12" Text="Intiface Central needs to be running with its server started."/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoConnectToggle" Grid.Column="1"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Plugins" Margin="0,0,0,6"/>
                    <StackPanel x:Name="PluginList" Spacing="8"/>
                    <TextBlock Classes="muted" FontSize="12"
                               Text="Turned off plugins aren't loaded at all and disappear from the sidebar. Extra plugins can be dropped into the Plugins folder next to Butthurt.exe."/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Advanced" Margin="0,0,0,6"/>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Settings file"/>
                                <TextBlock x:Name="SettingsPathText" Classes="muted" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="bt small" Content="Open folder" VerticalAlignment="Center"
                                    Click="OpenFolder_Click"/>
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Reset everything"/>
                                <TextBlock Classes="muted" FontSize="12" Text="Puts every setting, event and rule back to its default. This also forgets your Twitch login."/>
                            </StackPanel>
                            <Button x:Name="ResetButton" Grid.Column="1" Classes="bt small danger" Content="Reset"
                                    VerticalAlignment="Center" Click="Reset_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
