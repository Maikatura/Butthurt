<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Butthurt.Contracts.Views.SettingsView">

    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Classes="page">
        <StackPanel Spacing="20" Margin="32,28" MaxWidth="1040">

            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Settings"/>
                <TextBlock Classes="muted" Text="Everything is saved automatically."/>
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Startup" Margin="0,0,0,6"/>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Connect to Intiface when Butthurt starts"/>
                                <TextBlock Classes="muted" FontSize="12" Text="Intiface Central needs to be running with its server started."/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoConnectToggle" Grid.Column="1"/>
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Start the game watcher when Butthurt starts"/>
                                <TextBlock Classes="muted" FontSize="12" Text="It sits idle until a game window is in focus."/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoWatchToggle" Grid.Column="1"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="h2" Text="Advanced" Margin="0,0,0,6"/>

                    <Border Classes="row">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="h3" Text="Check the game every"/>
                                    <TextBlock Classes="muted" FontSize="12" Text="Lower is snappier, higher uses less CPU. 50 ms is plenty for most people."/>
                                </StackPanel>
                                <TextBlock x:Name="PollText" Grid.Column="1" Classes="stat" FontSize="18" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="PollSlider" Minimum="10" Maximum="250"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Settings file"/>
                                <TextBlock x:Name="SettingsPathText" Classes="muted" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="bt small" Content="Open folder" VerticalAlignment="Center"
                                    Click="OpenFolder_Click"/>
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Reset everything"/>
                                <TextBlock Classes="muted" FontSize="12" Text="Puts every setting and event back to its default."/>
                            </StackPanel>
                            <Button x:Name="ResetButton" Grid.Column="1" Classes="bt small danger" Content="Reset"
                                    VerticalAlignment="Center" Click="Reset_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
