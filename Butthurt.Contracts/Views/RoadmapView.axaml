<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Butthurt.Contracts.Views.RoadmapView">

    <ScrollViewer Classes="page">
        <StackPanel Spacing="20" Margin="32,28" MaxWidth="1040">

            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Roadmap"/>
                <TextBlock Classes="muted" Text="What's done and what's coming. No promises on dates."/>
            </StackPanel>

            <UniformGrid x:Name="RoadmapContainer" Columns="3"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
