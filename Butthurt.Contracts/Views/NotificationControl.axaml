<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Butthurt.Contracts.Views"
             x:Class="Butthurt.Contracts.Views.NotificationControl"
             x:DataType="local:NotificationControl">
  
    <Border x:Name="RootBorder"
            Background="{DynamicResource NotificationBackground}"
            CornerRadius="5"
            Padding="10"
            Opacity="0">
        <TextBlock x:Name="MessageTextBlock"
                   Text="{Binding Message}"
                   Foreground="{DynamicResource NotificationForeground}"/>
    </Border>
</UserControl>