<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Butthurt.Contracts.Views.HomeView">

    <ScrollViewer Classes="page">
        <StackPanel Spacing="20" Margin="32,28" MaxWidth="1040">

            <!-- Hero -->
            <Border CornerRadius="16" Padding="28" Background="{StaticResource HeroGradient}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="caption" Text="BUTTHURT" Foreground="#D8B4FE"/>
                        <TextBlock x:Name="HeroTitle" Classes="h1" Text="Get physically notified."/>
                        <TextBlock x:Name="HeroText" Classes="muted" MaxWidth="520" HorizontalAlignment="Left"
                                   Text="Connect your toy through Intiface Central and feel every hit you take in game, and every cheer, sub and redeem on stream."/>
                    </StackPanel>
                    <Button x:Name="StartStopButton" Grid.Column="1" Classes="bt primary" Padding="22,12"
                            VerticalAlignment="Center" Click="StartStopButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <iconPacks:PackIconLucide x:Name="StartStopIcon" Kind="Play" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StartStopText" Text="Start" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Status cards: Intiface and toys, then one card per plugin (added in code) -->
            <UniformGrid Columns="4" x:Name="StatusGrid" Margin="0,0,-12,-12">
                <Border x:Name="IntifaceCard" Classes="card" Margin="0,0,12,12">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="iconbox">
                                <iconPacks:PackIconLucide Kind="PlugZap" Width="20" Height="20" Foreground="#D8B4FE"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="INTIFACE"/>
                            <TextBlock x:Name="IntifaceText" Classes="stat" Text="Offline"/>
                            <TextBlock x:Name="IntifaceSubText" Classes="muted" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ToysCard" Classes="card" Margin="0,0,12,12">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="iconbox">
                                <iconPacks:PackIconLucide Kind="Vibrate" Width="20" Height="20" Foreground="#D8B4FE"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Classes="bt ghost small" HorizontalAlignment="Right"
                                    Content="Manage" Click="ManageToys_Click"/>
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="TOYS"/>
                            <TextBlock x:Name="ToysText" Classes="stat" Text="0 connected"/>
                            <TextBlock x:Name="ToysSubText" Classes="muted" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid ColumnDefinitions="*,16,1.4*">
                <!-- Quick test (toys only) -->
                <Border x:Name="QuickTestCard" Classes="card" VerticalAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="Quick test"/>
                            <TextBlock Classes="muted" Text="Make sure everything is wired up before you pull."/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="h3" Text="Intensity"/>
                            <TextBlock x:Name="TestIntensityText" Grid.Column="1" Classes="muted" Text="50%"/>
                        </Grid>
                        <Slider x:Name="TestIntensitySlider" Minimum="5" Maximum="100" Value="50"/>

                        <Button x:Name="TestButton" Classes="bt primary" HorizontalAlignment="Stretch" Click="TestButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <iconPacks:PackIconLucide Kind="Zap" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Buzz for 1 second" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TestHintText" Classes="muted" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Activity -->
                <Border x:Name="ActivityCard" Grid.Column="2" Classes="card">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Classes="h2" Text="Recent activity"/>
                            <iconPacks:PackIconLucide Grid.Column="1" Kind="Activity" Width="18" Height="18"
                                                      Foreground="{StaticResource DimBrush}"/>
                        </Grid>
                        <TextBlock x:Name="EmptyActivityText" DockPanel.Dock="Top" Classes="muted"
                                   Text="Nothing yet. Events from the game and your toys will show up here."/>
                        <StackPanel x:Name="ActivityList" Spacing="2"/>
                    </DockPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
