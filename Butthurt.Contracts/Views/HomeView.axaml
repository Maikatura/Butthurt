<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Butthurt.Contracts.Views.HomeView">

    <Grid>
        <StackPanel Spacing="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">

            <!-- Header -->
            <StackPanel Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Butthurt Home"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Get physically notified."
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Controls Section -->
            <StackPanel Spacing="15" HorizontalAlignment="Center">
                <TextBlock Text="Haptic Service"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <Button x:Name="StartStopButton"
                        Width="140"
                        Height="50"
                        CornerRadius="10"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="StartStopButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="DeviceList" Spacing="15" HorizontalAlignment="Center">
            </StackPanel>
            </StackPanel>
    </Grid>
</UserControl>