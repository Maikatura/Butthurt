<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Butthurt.Overlay.Views.OverlayView">

    <ScrollViewer Classes="page">
        <StackPanel Spacing="20" Margin="32,28" MaxWidth="1040">

            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Stream overlay"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Show the queue and an announcement for every rule on stream. Each rule's message is yours to write, in the rule's editor."/>
            </StackPanel>

            <!-- Server and OBS address -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="iconbox" Margin="0,0,14,0">
                            <iconPacks:PackIconLucide Kind="MonitorPlay" Width="20" Height="20" Foreground="#FAFAFA"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="h2" Text="OBS Browser source"/>
                                <Border Classes="pill" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatePillText" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="StateText" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="StartStopButton" Grid.Column="2" Classes="bt" VerticalAlignment="Center" Click="StartStop_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox x:Name="UrlBox" Classes="field" IsReadOnly="True"/>
                        <Button Grid.Column="1" Classes="bt small" Margin="8,0,0,0" VerticalAlignment="Center" Click="CopyUrl_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <iconPacks:PackIconLucide Kind="Copy" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="bt small" Margin="8,0,0,0" VerticalAlignment="Center" Click="Preview_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <iconPacks:PackIconLucide Kind="ExternalLink" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Classes="bt small" Margin="8,0,0,0" VerticalAlignment="Center" Click="OpenFolder_Click"
                                ToolTip.Tip="The overlay's html, css and js. Changing them can break the overlay: read README.txt first.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Customize" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="In OBS add a Browser source with this address, 1920 × 1080. It has a transparent background."/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="muted" FontSize="12" Text="Port" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="PortBox" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" MinWidth="130"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- What it shows and where -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="h2" Text="What it shows"/>
                        <TextBlock Classes="muted" Text="Changes show in OBS right away. Press the test button to see where announcements land."/>
                    </StackPanel>

                    <WrapPanel ItemSpacing="24" LineSpacing="8">
                        <CheckBox x:Name="QueueCheck" Content="Show the queue"/>
                        <CheckBox x:Name="AlertsCheck" Content="Show announcements"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="muted" FontSize="12" Text="Each announcement for (seconds)" VerticalAlignment="Center"/>
                            <NumericUpDown x:Name="AlertSecondsBox" Minimum="1" Maximum="60" Increment="1" FormatString="0" MinWidth="120"/>
                        </StackPanel>
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,32,Auto,32,*">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="Announcements"/>
                            <ContentControl x:Name="AlertPositionHost"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="Queue"/>
                            <ContentControl x:Name="QueuePositionHost"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="6" VerticalAlignment="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="muted" FontSize="12" Text="Size"/>
                                <TextBlock x:Name="ScaleText" Grid.Column="1" Classes="muted" FontSize="12"/>
                            </Grid>
                            <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Two Browser sources with different spots? Add options to the address, they win over the settings above: ?alerts=0 or ?queue=0 to show one part, ?alerts_at=bottom-left or ?queue_at=top-right to place it (any of top/middle/bottom with left/center/right), ?scale=1.5 for size. Combine them with &amp;."/>

                    <Button Classes="bt small" HorizontalAlignment="Left" Click="TestAnnouncement_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <iconPacks:PackIconLucide Kind="Sparkles" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Show a test announcement" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
