<Project Sdk="Microsoft.NET.Sdk">
    <!-- Stream overlay plugin: runs the local page for an OBS Browser source and holds its settings page.
         The server itself (OverlayService) stays in Contracts, so VRChat and others can announce without
         depending on this one. With this plugin off nothing is served and announcements simply go nowhere. -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Referenced directly (not only through Contracts) so the XAML compiler runs for this project -->
        <PackageReference Include="Avalonia" Version="11.3.6"/>
        <PackageReference Include="IconPacks.Avalonia" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Butthurt.Contracts\Butthurt.Contracts.csproj" />
    </ItemGroup>
</Project>
